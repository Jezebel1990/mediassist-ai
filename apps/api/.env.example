# Application
APP_NAME=MediAssist AI API
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database (SQLite)
DATABASE_URL=sqlite:///./data/mediassist.db

# Knowledge base
# DOCUMENTS_PATH=./storage/documents
# FAISS_PATH=./storage/faiss
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4

# OpenRouter / LLM (change MODEL_NAME to swap models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-oss-20b:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
